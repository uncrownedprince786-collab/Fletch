{
  "manifest_version": 3,
  "name": "Fletch Capture",
  "version": "1.0.0",
  "description": "Send links and videos from your browser to the Fletch download manager.",
  "permissions": [
    "contextMenus",
    "storage",
    "webRequest",
    "downloads",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fletch Capture",
    "default_icon": {
      "32": "icon32.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  },
  "key": "",
  "homepage_url": "https://github.com/uncrownedprince786-collab/Fletch"
}
